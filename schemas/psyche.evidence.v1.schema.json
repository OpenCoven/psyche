{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.evidence.v1",
  "title": "Psyche evidence v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.evidence.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts. It cannot express the parser-only rules listed in docs/protocol/RECORD-SCHEMAS.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "node_id",
    "attempt_id",
    "content_digest",
    "producer",
    "collection_method",
    "media_type",
    "size",
    "created_at",
    "retention_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.evidence.v1"
    },
    "evidence_id": {
      "$ref": "#/$defs/evidence_id"
    },
    "node_id": {
      "$ref": "#/$defs/graph_node_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "content_digest": {
      "$ref": "#/$defs/digest"
    },
    "producer": {
      "$ref": "#/$defs/label"
    },
    "collection_method": {
      "$ref": "#/$defs/label"
    },
    "media_type": {
      "$ref": "#/$defs/label"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "retention_policy": {
      "$ref": "#/$defs/label"
    }
  },
  "$defs": {
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evd_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "graph_node_id": {
      "type": "string",
      "pattern": "^nod_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[\\x00-\\x7F]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
