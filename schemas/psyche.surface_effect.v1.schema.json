{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.surface_effect.v1",
  "title": "Psyche surface effect v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.surface_effect.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts. It cannot express the parser-only rules listed in docs/protocol/RECORD-SCHEMAS.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity. effect_digest must be the SHA-256 of the RFC 8785 encoding of effect, which is parser-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface_effect_id",
    "intent_id",
    "graph_id",
    "node_id",
    "attempt_id",
    "familiar_snapshot_id",
    "project_id",
    "action_class",
    "account_id",
    "locator",
    "effect",
    "effect_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.surface_effect.v1"
    },
    "surface_effect_id": {
      "$ref": "#/$defs/surface_effect_id"
    },
    "intent_id": {
      "$ref": "#/$defs/intent_id"
    },
    "graph_id": {
      "$ref": "#/$defs/graph_id"
    },
    "node_id": {
      "$ref": "#/$defs/graph_node_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "familiar_snapshot_id": {
      "$ref": "#/$defs/identity_snapshot_id"
    },
    "project_id": {
      "$ref": "#/$defs/label"
    },
    "action_class": {
      "$ref": "#/$defs/label"
    },
    "account_id": {
      "$ref": "#/$defs/label"
    },
    "locator": {
      "$ref": "#/$defs/free_object"
    },
    "effect": {
      "$ref": "#/$defs/free_object"
    },
    "effect_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "free_object": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "graph_id": {
      "type": "string",
      "pattern": "^grf_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "graph_node_id": {
      "type": "string",
      "pattern": "^nod_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "identity_snapshot_id": {
      "type": "string",
      "pattern": "^ids_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^int_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "json_value": {
      "description": "Any JSON value whose integers, at any depth, lie within the interoperable range +/-(2^53-1).",
      "anyOf": [
        {
          "not": {
            "type": "integer"
          }
        },
        {
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ],
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "surface_effect_id": {
      "type": "string",
      "pattern": "^sfx_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[\\x00-\\x7F]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
