{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.intent.v1",
  "title": "Psyche intent v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.intent.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts. It cannot express the parser-only rules listed in docs/protocol/INTENT-SCHEMA.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "principal_id",
    "familiar_snapshot_id",
    "project_id",
    "requested_outcome",
    "constraints",
    "required_evidence",
    "created_at",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.intent.v1"
    },
    "intent_id": {
      "$ref": "#/$defs/intent_id"
    },
    "principal_id": {
      "$ref": "#/$defs/reference"
    },
    "familiar_snapshot_id": {
      "$ref": "#/$defs/identity_snapshot_id"
    },
    "project_id": {
      "$ref": "#/$defs/reference"
    },
    "requested_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "constraints": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "required_evidence": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "surface_event_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/surface_event_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "intent_id": {
      "type": "string",
      "pattern": "^int_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "identity_snapshot_id": {
      "type": "string",
      "pattern": "^ids_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "surface_event_id": {
      "type": "string",
      "pattern": "^sev_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[\\x00-\\x7F]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "json_value": {
      "description": "Any JSON value whose integers, at any depth, lie within the interoperable range +/-(2^53-1).",
      "anyOf": [
        {
          "not": {
            "type": "integer"
          }
        },
        {
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ],
      "items": {
        "$ref": "#/$defs/json_value"
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    }
  }
}
