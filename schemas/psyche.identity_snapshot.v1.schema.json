{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.identity_snapshot.v1",
  "title": "Psyche identity snapshot v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.identity_snapshot.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts, except the decoder-only encodings listed in docs/protocol/RECORD-SCHEMAS.md (a unit enum variant as a one-member object, a closed object as a positional array), which it rejects on purpose. It cannot express the parser-only rules listed in docs/protocol/RECORD-SCHEMAS.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "familiar_id",
    "principal_id",
    "revision",
    "declaration_digest",
    "identity_file_digest",
    "identity_digest",
    "soul_digest",
    "role_skill_digest",
    "provenance",
    "resolved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.identity_snapshot.v1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/identity_snapshot_id"
    },
    "familiar_id": {
      "$ref": "#/$defs/reference"
    },
    "principal_id": {
      "$ref": "#/$defs/reference"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "declaration_digest": {
      "$ref": "#/$defs/digest"
    },
    "identity_file_digest": {
      "$ref": "#/$defs/digest"
    },
    "identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "soul_digest": {
      "$ref": "#/$defs/digest"
    },
    "role_skill_digest": {
      "$ref": "#/$defs/digest"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familiar_home_id",
        "resolver_version"
      ],
      "properties": {
        "familiar_home_id": {
          "$ref": "#/$defs/reference"
        },
        "resolver_version": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "resolved_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity_snapshot_id": {
      "type": "string",
      "pattern": "^ids_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[\\x00-\\x7F]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
