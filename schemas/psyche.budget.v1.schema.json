{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.budget.v1",
  "title": "Psyche budget v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.budget.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts. It cannot express the parser-only rules listed in docs/protocol/RECORD-SCHEMAS.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "budget_id",
    "graph_id",
    "resource_class",
    "limit",
    "reserved",
    "consumed",
    "released"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.budget.v1"
    },
    "budget_id": {
      "$ref": "#/$defs/budget_id"
    },
    "graph_id": {
      "$ref": "#/$defs/graph_id"
    },
    "resource_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "limit": {
      "$ref": "#/$defs/amount"
    },
    "reserved": {
      "$ref": "#/$defs/amount"
    },
    "consumed": {
      "$ref": "#/$defs/amount"
    },
    "released": {
      "$ref": "#/$defs/amount"
    }
  },
  "$defs": {
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "budget_id": {
      "type": "string",
      "pattern": "^bud_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^grf_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
