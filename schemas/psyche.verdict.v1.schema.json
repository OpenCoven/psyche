{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.verdict.v1",
  "title": "Psyche verdict v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.verdict.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts. It cannot express the parser-only rules listed in docs/protocol/RECORD-SCHEMAS.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict_id",
    "node_id",
    "sealed_evidence_digest",
    "policy_revision",
    "verdict_type",
    "reviewer_id",
    "outcome",
    "reason_codes",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.verdict.v1"
    },
    "verdict_id": {
      "$ref": "#/$defs/verdict_id"
    },
    "node_id": {
      "$ref": "#/$defs/graph_node_id"
    },
    "sealed_evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "policy_revision": {
      "$ref": "#/$defs/label"
    },
    "verdict_type": {
      "$ref": "#/$defs/label"
    },
    "reviewer_id": {
      "$ref": "#/$defs/label"
    },
    "outcome": {
      "$ref": "#/$defs/label"
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "graph_node_id": {
      "type": "string",
      "pattern": "^nod_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[\\x00-\\x7F]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "verdict_id": {
      "type": "string",
      "pattern": "^vrd_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
