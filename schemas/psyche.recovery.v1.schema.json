{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:psyche:schema:psyche.recovery.v1",
  "title": "Psyche recovery v1 (experimental, unpublished)",
  "description": "Structural schema for one psyche.recovery.v1 document as accepted by psyche_core::contracts::decode_document. Experimental under #11: not a released artifact and not a stable contract. The schema accepts every document the typed decoder accepts. It cannot express the parser-only rules listed in docs/protocol/RECORD-SCHEMAS.md, so a document that passes this schema is not thereby valid. Only the typed decoder decides validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recovery_id",
    "attempt_id",
    "lease_id",
    "ambiguity",
    "reconciliation_count"
  ],
  "properties": {
    "schema_version": {
      "const": "psyche.recovery.v1"
    },
    "recovery_id": {
      "$ref": "#/$defs/recovery_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "fence_token": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "ambiguity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reconciliation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operator_disposition": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "recovery_id": {
      "type": "string",
      "pattern": "^rcv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
