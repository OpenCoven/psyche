{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psyche:experimental:adapter-lifecycle:output:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "approval_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_hex": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{2})+$",
      "maxLength": 8192
    },
    "executions": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "succeeded",
        "unknown"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z_]{1,64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "oneOf": [
    {
      "required": [
        "code",
        "executions"
      ],
      "maxProperties": 2
    },
    {
      "required": [
        "task_id",
        "action_id",
        "approval_id",
        "approval_digest",
        "receipt_hex",
        "state",
        "executions"
      ],
      "maxProperties": 9
    }
  ],
  "dependentRequired": {
    "request_id": [
      "request_digest"
    ],
    "request_digest": [
      "request_id"
    ]
  }
}
