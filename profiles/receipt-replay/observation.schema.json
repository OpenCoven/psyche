{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental receipt replay observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_digest", "receipt_hex", "executions"],
  "properties": {
    "schema_version": {"const": "psyche.experimental.receipt-replay.v1"},
    "request_id": {"type": "string", "pattern": "^req_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 8192},
    "executions": {"type": "integer", "minimum": 0}
  }
}
